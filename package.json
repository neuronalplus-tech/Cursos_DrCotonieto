{
  "name": "duelo-prolongado-eva",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-imports.mjs",
    "check:texto": "node scripts/auditar-mojibake.mjs",
    "reparar:texto": "node scripts/reparar-mojibake.mjs --aplicar",
    "smoke": "vite build --ssr scripts/smoke-render.jsx --outDir .smoke --logLevel error && node .smoke/smoke-render.js",
    "smoke:datos": "vite build --config vite.smoke.config.js --logLevel error && node .smoke-datos/smoke-datos.js",
    "test:foro-ui": "vite build --config vite.foro.config.js --logLevel error && node .smoke-foro-ui/test-foro-ui.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "jspdf": "^2.5.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "vite": "^4.4.0"
  }
}
